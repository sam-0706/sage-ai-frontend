# Desktop build-time config (electron-vite exposes MAIN_VITE_* to the main process only).
# Defaults to the production API when unset.
MAIN_VITE_SAGE_API_URL=https://sage-ai-backend-hazel.vercel.app

# Local development only (ignored in packaged builds):
# SAGE_API_URL=http://localhost:8787          # point at a local backend
# SAGE_DEV_EMAIL=someone@example.com          # backend must run with DEV_AUTH_BYPASS=true
# SAGE_USER_DATA_DIR=/tmp/sage-desktop-test   # isolate app data for tests
